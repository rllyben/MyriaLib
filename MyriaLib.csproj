<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
  </PropertyGroup>

  <!--
    Canonical, version-controlled copy of the shared static game-content JSON files
    (Data\common) and locale strings (Data\locales). MyriaRPG and MyriaServer link
    these same files into their own build output instead of keeping independent
    copies, so the three projects can no longer drift out of sync with each other.
    MyriaLib itself does not read these at its own assembly location; they only
    need to exist here so the other two projects have exactly one physical source
    to link against, consistent with how they already reference MyriaLib's code
    via ProjectReference.
  -->
  <ItemGroup>
    <None Include="Data\**\*.json" />
  </ItemGroup>

  <!--
    MyriaLib.Tests is a nested SDK-style project (see MyriaLib.Tests.csproj). Without this,
    MyriaLib's own implicit file globbing would also pick up the test project's .cs files
    and try to compile them into MyriaLib itself.
  -->
  <ItemGroup>
    <Compile Remove="MyriaLib.Tests\**" />
    <Content Remove="MyriaLib.Tests\**" />
    <EmbeddedResource Remove="MyriaLib.Tests\**" />
    <None Remove="MyriaLib.Tests\**" />
  </ItemGroup>

  <!--
    MyriaLib.Economy is a nested SDK-style project (see MyriaLib.Economy.csproj) — the first
    package pulled out of MyriaLib proper (Money/MoneyBag/MoneyFormatter/MoneyConverter), as a
    proof of concept for the library split. Same reason as the MyriaLib.Tests exclusion above:
    without this, MyriaLib's own implicit file globbing would compile the moved files a second
    time here too.
  -->
  <ItemGroup>
    <Compile Remove="MyriaLib.Economy\**" />
    <Content Remove="MyriaLib.Economy\**" />
    <EmbeddedResource Remove="MyriaLib.Economy\**" />
    <None Remove="MyriaLib.Economy\**" />
  </ItemGroup>

  <!--
    MyriaLib.Enums is a nested SDK-style project (see MyriaLib.Enums.csproj) — the second package
    pulled out of MyriaLib proper (Systems/Enums/*.cs), following the same proven pattern as
    MyriaLib.Economy. Same reason as the exclusions above: without this, MyriaLib's own implicit
    file globbing would compile the moved files a second time here too.
  -->
  <ItemGroup>
    <Compile Remove="MyriaLib.Enums\**" />
    <Content Remove="MyriaLib.Enums\**" />
    <EmbeddedResource Remove="MyriaLib.Enums\**" />
    <None Remove="MyriaLib.Enums\**" />
  </ItemGroup>

  <!--
    MyriaLib.Progression is a nested SDK-style project (see MyriaLib.Progression.csproj) — the
    third package pulled out of MyriaLib proper (GameTick/JobXpService/ClassXpService), following
    the same proven pattern as MyriaLib.Economy/MyriaLib.Enums. Same reason as the exclusions
    above: without this, MyriaLib's own implicit file globbing would compile the moved files a
    second time here too.
  -->
  <ItemGroup>
    <Compile Remove="MyriaLib.Progression\**" />
    <Content Remove="MyriaLib.Progression\**" />
    <EmbeddedResource Remove="MyriaLib.Progression\**" />
    <None Remove="MyriaLib.Progression\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="MyriaLib.Economy\MyriaLib.Economy.csproj" />
    <ProjectReference Include="MyriaLib.Enums\MyriaLib.Enums.csproj" />
    <ProjectReference Include="MyriaLib.Progression\MyriaLib.Progression.csproj" />
  </ItemGroup>

</Project>
